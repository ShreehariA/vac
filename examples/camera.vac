// VAC v1.10 fixture: a scene under a moving camera. A smooth, detailed
// landscape (no vector primitive describes it) is zoomed 1.5x about
// (260, 150) while a ball crosses in front of it. The decompiler must
// recover the camera — the scene as one image, its zoom as `position()`
// and `scale()` keyframes — and the ball as a shape on top.

canvas 480x320 @30fps

scene main {
  duration 2s

  let scene = image(0, 0, 480, 320, "data:image/png;base64,")

  animate scene {
    0ms -> position(0, 0), scale(1)
    2s  -> position(-130, -75), scale(1.5)
    easing: linear
  }

  let ball = ellipse(80, 250, 20, 20)
  ball.fill = #f4f4f4
  ball.stroke = none

  animate ball {
    0ms -> position(80, 250)
    2s  -> position(400, 80)
    easing: linear
  }
}
