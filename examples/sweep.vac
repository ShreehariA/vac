// VAC v1.22 fixture: a wipe and a push. One picture holds for a second;
// a second picture is uncovered over it from the right edge for a second,
// neither picture moving; it holds; then a third picture pushes it off to
// the left for a second, the two moving together; it holds. Every frame of
// either transition steps like a cut: the decompiler must find both, give
// each its own scene, and write the wipe as a growing `clip()` window and
// the push as two pictures under `position()` keyframes.

canvas 480x320 @30fps

scene main {
  duration 5s

  let first = image(0, 0, 480, 320, "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAUCAIAAABj86gYAAAACXBIWXMAAAABAAAAAQBPJcTWAAAAgUlEQVR4nGPcu3cvAypgZHRGE3FiQFfD8B9dzV7nfWgiKUrK9+/dZUHXSW0wasGoBaMWjFowKCxwdmZEE2JiYkIT2fsPXY0rhhrnff/RzXFR3Lt3Nx2CyHYlmtA/hlQg+ffANKwaHJgrgaT1vxI08cNO6DXEPwYGb2/vYRDJtLYAANQJG2bLUVDnAAAAAElFTkSuQmCC")

  let second = image(0, 0, 480, 320, "data:image/png;base64,")

  animate second {
    0ms    -> clip(480, 0, 0, 320), position(0, 0)
    1000ms -> clip(480, 0, 0, 320)
    2000ms -> clip(0, 0, 480, 320)
    3000ms -> position(0, 0)
    4000ms -> position(-480, 0)
    easing: linear
  }

  let third = image(480, 0, 480, 320, "data:image/png;base64,")

  animate third {
    0ms    -> position(480, 0)
    3000ms -> position(480, 0)
    4000ms -> position(0, 0)
    easing: linear
  }
}
