// VAC v1.25 fixture: a credits roll. A sheet of six lines of text, taller
// than the frame, scrolls up through it at 150 px a second over a flat
// ground. The text is the only thing to see, a tenth of the pixels, and
// within a second the scroll has left the first frame's view: the
// decompiler must keep its camera going, and recover the roll as one
// picture under one camera, not as a hundred moving letters.

canvas 240x160 @30fps

scene main {
  duration 3s

  let bg = rect(0, 0, 240, 160)
  bg.fill = #14161f

  let sheet = image(0, 160, 240, 450, "data:image/png;base64,")

  animate sheet {
    0ms -> position(0, 160)
    3s  -> position(0, -290)
    easing: linear
  }
}
