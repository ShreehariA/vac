// Fixture (v1.6): scenery no vector primitive can describe.
//
// A smooth, detailed texture fills the background (a 64x48 image stretched
// over the canvas); a ball rolls across it. Vector shapes approximate the
// texture as flat patches; the decompiler should measure that and choose a
// raster plate for the scenery, keeping the ball as code on top of it.

canvas 480x320 @30fps

scene main {
  duration 2s

  let scenery = image(0, 0, 480, 320, "data:image/png;base64,")

  let ball = ellipse(60, 240, 26, 26)
  ball.fill = #f8f8f8
  ball.stroke = none

  animate ball {
    0ms -> position(60, 240)
    2s  -> position(420, 240)
    easing: linear
  }
}
