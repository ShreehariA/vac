// VAC v1.8 fixture: a textured tile — a smooth, many-coloured swirl that
// no flat fill describes — sliding across a flat background. The tile's
// motion is code; its appearance can only be its own pixels. The decompiler
// must recover it as a sprite (an `image()` keyframed like any shape).

canvas 480x320 @30fps

scene main {
  duration 2s

  let bg = rect(0, 0, 480, 320)
  bg.fill = #20232b

  let tile = image(40, 120, 72, 72, "data:image/png;base64,")

  animate tile {
    0ms    -> position(40, 120)
    2s     -> position(360, 140)
    easing: linear
  }
}
